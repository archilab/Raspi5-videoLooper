[Unit]
Description=Raspberry Pi Video Looper
After=local-fs.target rtc-time-restore.service
Wants=rtc-time-restore.service

[Service]
Type=simple
User=looper
Group=looper
WorkingDirectory=/home/looper/video_looper
ExecStartPre=-+/bin/sh -c 'for i in $$(seq 1 30); do [ -e /sys/class/graphics/fb0/blank ] && break; sleep 1; done; chgrp looper /sys/class/graphics/fb0/blank; chmod g+w /sys/class/graphics/fb0/blank'
ExecStart=/usr/bin/python3 /home/looper/video_looper/video_looper.py
CapabilityBoundingSet=CAP_SYS_TIME CAP_WAKE_ALARM
AmbientCapabilities=CAP_SYS_TIME CAP_WAKE_ALARM
NoNewPrivileges=no
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables for VLC
Environment=DISPLAY=:0
Environment=HOME=/home/looper
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=xcb
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
