[Unit]
Description=Raspberry Pi Video Looper
After=network.target

[Service]
Type=simple
User=USER_PLACEHOLDER
Group=USER_PLACEHOLDER
WorkingDirectory=INSTALL_DIR_PLACEHOLDER
ExecStart=/usr/bin/python3 INSTALL_DIR_PLACEHOLDER/video_looper.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables for VLC
Environment=DISPLAY=:0
Environment=HOME=HOME_PLACEHOLDER
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=xcb

[Install]
WantedBy=graphical.target
