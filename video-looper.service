[Unit]
Description=Raspberry Pi Video Looper
After=network.target graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=USER_PLACEHOLDER
Group=USER_PLACEHOLDER
WorkingDirectory=INSTALL_DIR_PLACEHOLDER
ExecStart=/usr/bin/python3 INSTALL_DIR_PLACEHOLDER/video_looper.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=DISPLAY=:0
Environment=HOME=HOME_PLACEHOLDER

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=VIDEOS_DIR_PLACEHOLDER /var/log /tmp /run/user/1000 /run/user/1000/.X11-unix /tmp/.X11-unix

# Allow X11 access for VLC
Environment=XAUTHORITY=HOME_PLACEHOLDER/.Xauthority

[Install]
WantedBy=graphical.target
