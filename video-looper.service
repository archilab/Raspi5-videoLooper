[Unit]
Description=Raspberry Pi Video Looper
After=network.target graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
User=looper
Group=looper
WorkingDirectory=/home/looper/video_looper
ExecStart=/usr/bin/python3 /home/looper/video_looper/video_looper.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables for VLC
Environment=DISPLAY=:0
Environment=HOME=/home/looper
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=QT_QPA_PLATFORM=xcb

[Install]
WantedBy=graphical.target
